# ==============================================================================
# Arya Noble AI Chatbot - Backend Environment Configuration (.env.example)
# Copy this file to .env and adjust the values according to your environment.
# ==============================================================================

# --- Core Application Settings ---
PROJECT_NAME="Arya Noble Chatbot API"
ENVIRONMENT=production
# 32-byte Base64 key for encrypting sensitive credentials stored in DB
SECRET_ENCRYPTION_KEY=HD77PDBToZJLKpGJlUKP1HKLH3LcwUe1TUl1ZrTl6MU=
RATE_LIMIT_PER_MINUTE=60
# Monthly token limit threshold for document ingestion (default: 1,000,000 tokens)
INGESTION_MONTHLY_TOKEN_LIMIT=1000000

# --- Core Database Connection (AsyncIO - asyncpg) ---
# Local / Direct connection:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/arya_noble
# Inside Docker Network:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/arya_noble

# --- PGVector Store Connection (psycopg / RAG) ---
PG_HOST=localhost # Use "db" inside docker network, "localhost" on host machine
PG_PORT=5432
PG_DB=arya_noble
PG_USER=postgres
PG_PASSWORD=postgres
PG_COLLECTION_NAME=arya_noble_kb
VECTOR_STORE_PROVIDER=pgvector # "pgvector" | "qdrant"

# --- Security & JWT Authentication ---
SECRET_KEY=supersecretkey_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie domain configuration:
COOKIE_DOMAIN=.aryanoble.web.id

# Optional: COOKIE_SECURE (defaults to true if COOKIE_DOMAIN is set)
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax

# Comma-separated allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,https://dokterpedia-dev.aryanoble.web.id,https://dokterpedia-staging.aryanoble.web.id,https://dokterpedia.aryanoble.co.id

# --- S3 / MinIO Object Storage ---
S3_ENDPOINT_URL=http://localhost:9000 # Use "http://minio:9000" inside docker network
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=erha-knowledge-assets
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# --- File Storage ---
UPLOAD_DIR=data/uploads

# --- External CIS Integration ---
# Path to CIS RSA public key file (PEM or OpenSSH format)
CIS_RSA_PUBLIC_KEY_PATH=keys/cis_public_key.pem
# or, provide raw public key content directly:
# CIS_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- AI & RAG Subsystem Settings ---

# --- Option 1: OpenAI (Default) ---
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-5.4-mini
OPENAI_MODEL_NAME=gpt-5.4-mini
VISION_MODEL_NAME=gpt-5.4-mini
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-small

# --- Option 2: Google Gemini ---
# LLM_PROVIDER=gemini
# OPENAI_MODEL_NAME=gemini-3.5-flash
# OPENAI_API_KEY=your-gemini-api-key-here
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL_NAME=models/gemini-embedding-001

# --- Option 3: Local HuggingFace Embeddings ---
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL_NAME=BAAI/bge-m3

# Embedding & Reranker Models Configuration
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANK_CONFIDENCE_THRESHOLD=0.1

# --- Chunking, Ingestion & BM25 Configuration ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_INGESTION_CONCURRENCY=3
BM25_INDEX_PATH=./data/output/bm25_index.pkl

# --- AI Agent Settings ---
RAG_AGENT_ENABLED=true
RAG_AGENT_MAX_ITERATIONS=5

# --- Guardrails Settings ---
GUARDRAILS_ENABLED=true
GUARDRAILS_BLOCK_OFFTOPIC=true
GUARDRAILS_REDACT_PII=true

# --- Suppress Terminal Progress Bars & Parallelism ---
HF_HUB_DISABLE_PROGRESS_BARS=1
HF_HUB_VERBOSITY=error
TOKENIZERS_PARALLELISM=false

# --- MinIO S3 Object Storage Configuration ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=images
S3_DOCUMENTS_BUCKET=knowledge-documents
S3_STAGING_BUCKET=staging
S3_APPROVED_BUCKET=approved
S3_REGION=us-east-1
S3_USE_PATH_STYLE=True
