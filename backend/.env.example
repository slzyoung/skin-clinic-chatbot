# ==============================================================================
# Arya Noble AI Chatbot - Backend Environment Configuration (.env.example)
# Copy this file to .env and adjust the values according to your environment.
# ==============================================================================

# --- Core Application Settings ---
PROJECT_NAME="Arya Noble Chatbot API"

# --- Core Database Connection (AsyncIO) ---
# PostgreSQL connection string for AsyncIO core backend (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/arya_noble

# --- PGVector Store Connection (Sync / RAG) ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=arya_noble
PG_USER=postgres
PG_PASSWORD=postgres
PG_COLLECTION_NAME=arya_noble_kb

# --- Security & JWT Authentication ---
SECRET_KEY=supersecretkey_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File Storage ---
UPLOAD_DIR=data/uploads

# --- External CIS Integration ---
CIS_RSA_PUBLIC_KEY_PATH=keys/cis_public_key.pem

# --- AI & RAG Subsystem Settings ---
LLM_PROVIDER=openai
OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=sk-proj-...

# Embedding & Reranker Models
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANK_CONFIDENCE_THRESHOLD=0.1

# Chunking & BM25 Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
BM25_INDEX_PATH=./data/output/bm25_index.pkl

# --- Suppress Terminal Progress Bars ---
HF_HUB_DISABLE_PROGRESS_BARS=1
HF_HUB_VERBOSITY=error
TOKENIZERS_PARALLELISM=false
