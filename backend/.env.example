# ==============================================================================
# Arya Noble AI Chatbot - Backend Environment Configuration (.env.example)
# Copy this file to .env and adjust the values according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="Arya Noble Chatbot API"
ENVIRONMENT=development # "development" | "staging" | "production"
SECRET_ENCRYPTION_KEY=HD77PDBToZJLKpGJlUKP1HKLH3LcwUe1TUl1ZrTl6MU=
RATE_LIMIT_PER_MINUTE=60
INGESTION_MONTHLY_TOKEN_LIMIT=1000000
UPLOAD_DIR=data/uploads

# ------------------------------------------------------------------------------
# 2. DATABASE & VECTOR STORE (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# SQLAlchemy Async Engine (asyncpg):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/arya_noble

# PGVector / Psycopg Direct Connection (RAG Subsystem):
PG_HOST=localhost # Set to "db" when running in Docker Compose or K8s service name
PG_PORT=5432
PG_DB=arya_noble
PG_USER=postgres
PG_PASSWORD=postgres
PG_COLLECTION_NAME=arya_noble_kb
VECTOR_STORE_PROVIDER=pgvector

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT & Cookies)
# ------------------------------------------------------------------------------
SECRET_KEY=supersecretkey_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie domain settings (e.g. ".aryanoble.web.id" for subdomains, or leave blank for localhost)
COOKIE_DOMAIN=.aryanoble.web.id
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax

# Allowed CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,https://dokterpedia-dev.aryanoble.web.id,https://dokterpedia-staging.aryanoble.web.id,https://dokterpedia.aryanoble.co.id

# ------------------------------------------------------------------------------
# 4. S3 / MINIO OBJECT STORAGE
# ------------------------------------------------------------------------------
# Local MinIO Settings (Leave empty/unset in AWS EKS with IRSA):
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_USE_PATH_STYLE=true

# AWS S3 Settings (AWS IRSA uses AWS_ROLE_ARN & AWS_WEB_IDENTITY_TOKEN_FILE):
S3_BUCKET=images
S3_DOCUMENTS_BUCKET=knowledge-documents
S3_STAGING_BUCKET=staging
S3_APPROVED_BUCKET=approved
S3_REGION=us-east-1

# Optional: Public CDN / API Prefix for Storage (Leave commented for clean relative /api/storage paths)
# S3_PUBLIC_URL=http://localhost:8000/api/storage

# ------------------------------------------------------------------------------
# 5. EXTERNAL CLINIC INFORMATION SYSTEM (CIS) INTEGRATION
# ------------------------------------------------------------------------------
CIS_RSA_PUBLIC_KEY_PATH=keys/cis_public_key.pem
# CIS_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ------------------------------------------------------------------------------
# 6. AI & RAG SUBSYSTEM CONFIGURATION
# ------------------------------------------------------------------------------
# Primary LLM & Embedding (OpenAI):
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-5.4-mini
OPENAI_MODEL_NAME=gpt-5.4-mini
VISION_MODEL_NAME=gpt-5.4-mini
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-small

# Reranker Model:
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANK_CONFIDENCE_THRESHOLD=0.1

# Chunker & Pipeline Settings:
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_INGESTION_CONCURRENCY=3
BM25_INDEX_PATH=./data/output/bm25_index.pkl

# AI Agent & Guardrails:
RAG_AGENT_ENABLED=true
RAG_AGENT_MAX_ITERATIONS=5
GUARDRAILS_ENABLED=true
GUARDRAILS_BLOCK_OFFTOPIC=true
GUARDRAILS_REDACT_PII=true

# Suppress HuggingFace / Tokenizer Terminal Warnings:
HF_HUB_DISABLE_PROGRESS_BARS=1
HF_HUB_VERBOSITY=error
TOKENIZERS_PARALLELISM=false
