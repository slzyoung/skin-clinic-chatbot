# ==============================================================================
# Arya Noble AI Chatbot - Backend Environment Configuration (.env.example)
# Copy this file to .env and adjust the values according to your environment.
# ==============================================================================

# --- Core Application Settings ---
PROJECT_NAME="Arya Noble Chatbot API"

# --- Database Connection ---
# PostgreSQL connection string with pgvector support
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/arya_noble

# --- Security & JWT Authentication ---
SECRET_KEY=supersecretkey_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File Storage ---
UPLOAD_DIR=data/uploads

# --- External CIS (Customer Information System) Integration ---
CIS_BASE_URL=http://localhost:8001
CIS_API_TOKEN=default_cis_token

# --- RAG & Embedding Model Settings ---
# EMBEDDING_PROVIDER options: huggingface | openai | google
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# --- LLM Provider Settings & API Keys ---
LLM_MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=AIzaSy...
